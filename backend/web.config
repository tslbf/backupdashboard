<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS hosting via HttpPlatformHandler.

  IIS launches and owns the uvicorn process, listening on a private loopback
  port that IIS assigns (%HTTP_PLATFORM_PORT%) and reverse-proxies to. One
  process still serves both /api/* and the built React bundle - IIS is only
  the front door (TLS on 443, and a place to add Windows auth / Entra later).

  WHY THIS FILE LIVES IN backend\  (and the IIS site root must point here):
  config.py loads ".env" by a RELATIVE path and the dev DB is
  "sqlite:///./...", so the process only resolves them when its working
  directory is backend\. HttpPlatformHandler runs the child process with its
  CWD set to the site's physical path, so the site physical path MUST be this
  backend\ folder. Install-IIS.ps1 does that.

  The React bundle is still found by an absolute path in main.py
  (frontend/dist, two levels up), so serving the SPA is unaffected.

  PREREQUISITE: the HttpPlatformHandler module must be installed on the box
  (it is not part of a default IIS install). See docs/iis-and-runner.md.

  KEEPING THE 08:00 SCHEDULER ALIVE: HttpPlatformHandler ties the Python
  process to the IIS worker, and a worker with no traffic would normally idle
  out - which would silently skip the morning collect/digest. Install-IIS.ps1
  sets the app pool to startMode=AlwaysRunning, idleTimeout=0 and no periodic
  recycle so the process stays up and the scheduler fires whether or not
  anyone has the page open. Do not undo those pool settings.
-->
<configuration>
  <system.webServer>
    <handlers>
      <!-- remove-then-add so re-applying web.config never doubles the handler -->
      <remove name="httpPlatformHandler" />
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <!--
      processPath is resolved relative to the site physical path (backend\),
      so .\.venv\Scripts\python.exe is the venv update-and-run.cmd / redeploy.ps1
      build. arguments binds uvicorn to loopback on the port IIS hands us.

      startupTimeLimit is generous because first start runs init-db, which
      against SQL Server can take longer than the 10s default and would
      otherwise be reported as a 502.
    -->
    <httpPlatform processPath=".\.venv\Scripts\python.exe"
                  arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile="..\logs\httpplatform.log"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:04:00">
      <environmentVariables>
        <!-- unbuffered so the stdout log tails in real time, utf-8 so London
             server names and vendor strings don't choke on cp1252 -->
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
      </environmentVariables>
    </httpPlatform>

    <!-- Uvicorn already sets its own response headers; keep IIS from adding
         the Server banner. Harmless if the module isn't present. -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
  </system.webServer>
</configuration>
