# Copy to .env and fill in. Any source left blank is simply disabled.
#
# SECRETS: every credential below also accepts two non-plaintext forms —
#   dpapi:<token>   Windows DPAPI, generate with: python -m app.cli protect
#   file:<path>     read from an NTFS-ACL'd file
# e.g. VEEAM_PASSWORD=dpapi:AQAAANCMnd8...   (see docs/secrets-windows.md)

# --- App database (SQL Server in production; SQLite works for evaluation) ----
#
# This is the app's OWN database — its tables (servers, backup_events,
# server_days, collector_runs) live here. It is NOT BackupReporting: that one is
# the legacy table the PowerShell scripts write, and this app only ever reads it,
# once, for the backfill (see LEGACY_DB_URL below). Create an empty database and
# `init-db` builds the tables on first start.
#
# The empty slot before @ means Windows authentication — the same thing the
# PowerShell scripts do with "Integrated Security=True". SQLAlchemy adds
# Trusted_Connection=Yes itself, so do not add it here as well. The connection
# runs as whichever account launches the app, so a service account needs the
# rights, not just your login.
APP_DB_URL=mssql+pyodbc://@AZUSCCM01/BackupDashboard?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# SQL authentication instead — any @ : / ? in the password must be
# percent-encoded (@ becomes %40, : becomes %3A) or it is parsed as the host:
#APP_DB_URL=mssql+pyodbc://svc_backupdash:CHANGEME@AZUSCCM01/BackupDashboard?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# Named instance — use a literal backslash. %5C is NOT decoded and silently
# produces a broken server name:
#APP_DB_URL=mssql+pyodbc://@AZUSCCM01\SQLEXPRESS/BackupDashboard?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# SQLite, for evaluating without SQL Server at all:
#APP_DB_URL=sqlite:///./backupdashboard.db

# --- Time --------------------------------------------------------------------
# The timezone you read the dashboard in. Decides which night is "last night".
DISPLAY_TIMEZONE=America/New_York
# The local hour that divides one backup night from the next, per server.
# 12 means a night runs noon-to-noon: everything that finishes between noon
# yesterday and noon today is "last night", in each server's OWN timezone.
# Raise it only if servers routinely back up in the early afternoon.
NIGHT_CUTOFF_HOUR=12

# A server with no backup in this many days stops being expected nightly, so a
# decommissioned box doesn't post a "No backup" row forever.
STALE_SERVER_DAYS=14
# Raw event retention. 0 keeps everything.
EVENT_RETENTION_DAYS=400

# --- Veeam Backup & Replication (REST API, port 9419) ------------------------
# Comma-separated VBR servers. Needs a VBR account with at least the
# "Veeam Backup Viewer" role.
VEEAM_SERVERS=PGHVEEAM.LBFOSTERCO.COM,DUBVEEAM.LBFOSTERCO.COM
VEEAM_USERNAME=
VEEAM_PASSWORD=
VEEAM_API_VERSION=1.2-rev0
# VBR ships a self-signed certificate by default. Set true once you have put a
# trusted cert on the appliance.
VEEAM_VERIFY_TLS=false
# The single TLS protocol to offer: 1.0, 1.1, 1.2, 1.3, or auto.
# Same idea as the PowerShell's SecurityProtocol = Tls12 — name one and only
# that one is offered, because an older Windows TLS stack resets the connection
# rather than negotiating down from a hello it cannot parse. That reset arrives
# as "[WinError 10054] An existing connection was forcibly closed", which says
# nothing about TLS.
#   python -m app.cli probe veeam
# tries every version against the appliance and prints the one to put here.
#VEEAM_TLS_VERSION=1.2

# --- N-able Cove / Backup Manager (JSON-RPC) ---------------------------------
# These are the UK devices — see DISPLAY_TIMEZONE note above and docs/timezones.md.
NABLE_PARTNER=LBFosterBackup
NABLE_USERNAME=api-nable
NABLE_PASSWORD=
# Optional: the partner id is resolved from the name at runtime; this is only a
# fallback if GetPartnerInfo is unavailable.
NABLE_PARTNER_ID=196148

# --- Azure Backup (ARM REST, app registration with Reader on the vaults) -----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional: limit to specific subscriptions (IDs or display names). Blank = all.
#AZURE_SUBSCRIPTIONS=
#
# SQL Server and SAP HANA inside a VM back their transaction logs up every 15
# minutes, per database, and ARM reports each one as operation "Backup" — the
# same as the nightly full, with no server-side filter that separates them.
# Sixty databases produce ~23,000 log jobs in a 96-hour window, which buries the
# nightly picture this dashboard is for and makes every collection slow.
# Set true only if a failed log backup is something you want on the dashboard.
#AZURE_INCLUDE_LOG_BACKUPS=false

# --- Legacy BackupReporting import (one-time backfill) -----------------------
# The database the PowerShell scripts have been writing to. Read-only, and a
# different database from APP_DB_URL above.
# Run it with:  python -m app.cli collect legacy
LEGACY_DB_URL=mssql+pyodbc://@AZUSCCM01/BackupReporting?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
LEGACY_TABLE=dbo.BackupEvents
# Those scripts converted to Eastern before writing, so the importer has to
# convert back. Change only if that changes.
LEGACY_STORED_TIMEZONE=America/New_York

# --- Scheduler ----------------------------------------------------------------
SCHEDULER_ENABLED=true
# Per-source poll intervals in minutes (0 = don't schedule, manual runs only)
#VEEAM_INTERVAL=60
#NABLE_INTERVAL=60
#AZURE_INTERVAL=60
#LEGACY_INTERVAL=0

# How far back each collector asks for. Re-importing a run is a no-op upsert;
# missing one is a hole in the history, so these are deliberately generous.
#VEEAM_LOOKBACK_HOURS=96
#NABLE_LOOKBACK_HOURS=96
#
# Azure is the one worth tuning. ARM pages backupJobs by a per-job cursor, so a
# busy vault returns roughly one record per HTTP round trip and a wide window
# means thousands of requests every run. If the Azure collector takes minutes,
# lower this — 48 matches what the PowerShell used and still covers a long
# weekend.
#AZURE_LOOKBACK_HOURS=96

# --- Web -----------------------------------------------------------------------
# Dev-server origin allowed for CORS; irrelevant once the built frontend is
# served by the backend itself.
CORS_ORIGINS=http://localhost:5173
